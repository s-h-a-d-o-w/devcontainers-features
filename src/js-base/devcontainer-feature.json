{
  "id": "js-base",
  "name": "JavaScript Base",
  "version": "1.3.1",
  "description": "Intended to be used with mcr.microsoft.com/devcontainers/javascript-node",
  "documentationURL": "https://github.com/s-h-a-d-o-w/devcontainers-features/tree/main/src/js-base",
  "licenseURL": "https://github.com/s-h-a-d-o-w/devcontainers-features/blob/main/LICENSE",

  "postCreateCommand": "/usr/local/share/js-base-post-create.sh",

  "mounts": [
    {
      // Share the pnpm store across devcontainers
      "source": "devcontainer-pnpm-store",
      "target": "/.pnpm-store",
      "type": "volume"
    },
    {
      // Keep node_modules out of the bind mounted workspace, so that the host doesn't see (or interfere with) container dependencies.
      "source": "devcontainer-node-modules-${devcontainerId}",
      "target": "${containerWorkspaceFolder}/node_modules",
      "type": "volume"
    },
    {
      // Share zsh history
      "source": "devcontainer-zsh-history",
      "target": "/commandhistory",
      "type": "volume"
    }
  ],

  "containerEnv": {
    "pnpm_config_store_dir": "/.pnpm-store",
    "pnpm_config_enable_global_virtual_store": "true"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      // Extensions that don't work if not installed within the devcontainer
      "extensions": [
        "ms-playwright.playwright",
        "eamodio.gitlens",
        "oxc.oxc-vscode"
      ]
    }
  }
}
